<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="PlaybackScrimVeil" StartPoint="0%,0%" EndPoint="0%,100%" ColorInterpolationMode="ScRgbLinearInterpolation">
    <GradientStop Offset="0" Color="{DynamicResource PlaybackScrimColor}" />
    <GradientStop Offset="0.6" Color="#66000000" />
    <GradientStop Offset="1" Color="#CC000000" />
  </LinearGradientBrush>
</ResourceDictionary>
