<!-- teknesyum-ui template durum/avalonia/GuncellemePaneli.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="{{AD}}.Kabuk.GuncellemePaneli"
             Width="{StaticResource ModalWidth}"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             ClipToBounds="False">

  <UserControl.Resources>
    <ControlTheme x:Key="PanelKapat" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Width" Value="{StaticResource TargetMin}"/>
      <Setter Property="Height" Value="{StaticResource TargetMin}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TInstant}" Easing="{StaticResource EOut}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Foreground" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Foreground" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border#Kutu">
      <Setter Property="BorderBrush" Value="{StaticResource Warning50}"/>
    </Style>
    <Style Selector="Border#Kutu.hazir">
      <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="{StaticResource TBase}" Easing="{StaticResource EOut}"/>
    </Transitions>
  </UserControl.Transitions>

  <Border Name="Kutu" Theme="{StaticResource Panel}" ClipToBounds="False">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space4}" ClipToBounds="False">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space2}" ClipToBounds="False">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Image Name="LogoResmi" Width="{StaticResource IconSize3}" Height="{StaticResource IconSize3}"
                 VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock Name="BaslikYazisi" Theme="{StaticResource H3}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Name="KapatDugmesi" Grid.Column="1" Theme="{StaticResource PanelKapat}" AutomationProperties.Name="{Binding $self.(ToolTip.Tip)}">
          <Path Data="M0 0L14 14M14 0L0 14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                Width="{StaticResource IconSize1}" Height="{StaticResource IconSize1}"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="{StaticResource Space1}">
        <TextBlock Name="DurumYazisi" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <TextBlock Name="SurumEtiketiYazisi" Theme="{StaticResource Label}" VerticalAlignment="Center"/>
          <TextBlock Name="SurumYazisi" Theme="{StaticResource MonoValue}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <Grid Name="Ilerleme" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
        <Border Name="Iz" Grid.Column="0" Height="{StaticResource Space2}" CornerRadius="{StaticResource Radius}"
                Background="{StaticResource Renk1x10}" VerticalAlignment="Center" ClipToBounds="True">
          <Border Name="Dolgu" HorizontalAlignment="Stretch" CornerRadius="{StaticResource Radius}"
                  RenderTransformOrigin="0%,50%">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Offset="0" Color="{StaticResource Renk1Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Renk2Color}"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Border>
        <TextBlock Name="YuzdeYazisi" Grid.Column="1" Theme="{StaticResource MonoValue}" VerticalAlignment="Center"/>
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="{StaticResource Space3}" ClipToBounds="False">
        <Button Name="IndirVeYukleDugmesi" Theme="{StaticResource PrimaryButton}" AutomationProperties.Name="{Binding $self.Content}"/>
        <Button Name="IndirDugmesi" Theme="{StaticResource GhostButton}" AutomationProperties.Name="{Binding $self.Content}"/>
        <Button Name="IptalDugmesi" Theme="{StaticResource GhostButton}" AutomationProperties.Name="{Binding $self.Content}"/>
        <Button Name="YukleDugmesi" Theme="{StaticResource PrimaryButton}" AutomationProperties.Name="{Binding $self.Content}"/>
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
