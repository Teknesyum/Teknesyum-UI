<!-- teknesyum-ui template durum/avalonia/GuncellemePaneli.axaml · düzen 2 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="{{AD}}.Kabuk.GuncellemePaneli"
             Width="{StaticResource ModalWidth}"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Classes="kurulum"
             ClipToBounds="False">

  <UserControl.Resources>
    <ControlTheme x:Key="KurIkincil" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize1}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightBody}"/>
      <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TInstant}" Easing="{StaticResource EOut}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk1x10}"/>
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk1x10}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk1x10}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="KurBirincil" TargetType="Button" BasedOn="{StaticResource KurIkincil}">
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="{DynamicResource KurParlama}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TInstant}" Easing="{StaticResource EOut}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#bd">
        <Setter Property="BoxShadow" Value="{DynamicResource KurParlamaGuclu}"/>
      </Style>
      <Style Selector="^:focus-visible /template/ Border#bd">
        <Setter Property="BoxShadow" Value="{DynamicResource KurParlamaGuclu}"/>
      </Style>
      <Style Selector="^:disabled /template/ Border#bd">
        <Setter Property="BoxShadow" Value="{DynamicResource KurParlama}"/>
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border#Kutu">
      <Setter Property="BorderBrush" Value="{StaticResource Warning50}"/>
    </Style>
    <Style Selector="Border#Kutu.hazir">
      <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="{StaticResource TBase}" Easing="{StaticResource EOut}"/>
    </Transitions>
  </UserControl.Transitions>

  <Border Name="Kutu" Theme="{StaticResource Panel}" ClipToBounds="False">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Space3}" ClipToBounds="False">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space2}" ClipToBounds="False">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Image Name="LogoResmi" Width="{StaticResource IconSize3}" Height="{StaticResource IconSize3}"
                 VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock Name="BaslikYazisi" VerticalAlignment="Center" FontFamily="{StaticResource FontSans}"
                     FontSize="{StaticResource FontSize3}" FontWeight="{StaticResource WeightSemi}"
                     Foreground="{StaticResource TextBody}"/>
        </StackPanel>
        <Button Name="KapatDugmesi" Grid.Column="1" Theme="{StaticResource WindowButton}" Classes="close" Focusable="True"
                MinHeight="{StaticResource TitleBarHeightMin}" Height="{StaticResource TitleBarHeightMin}"
                VerticalAlignment="Center" AutomationProperties.Name="{Binding $self.(ToolTip.Tip)}">
          <Path Data="M0 0L14 14M14 0L0 14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                Width="{StaticResource IconSize1}" Height="{StaticResource IconSize1}"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="{StaticResource Space1}">
        <TextBlock Name="DurumYazisi" TextWrapping="Wrap" FontFamily="{StaticResource FontSans}"
                   FontSize="{StaticResource FontSize1}" Foreground="{StaticResource TextBody}"/>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <TextBlock Name="SurumEtiketiYazisi" Theme="{StaticResource Label}" VerticalAlignment="Center"/>
          <TextBlock Name="SurumYazisi" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}"
                     FontSize="{StaticResource FontSize1}" Foreground="{StaticResource TextBody}"/>
        </StackPanel>
      </StackPanel>

      <Grid Name="Ilerleme" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
        <Border Name="Iz" Grid.Column="0" Height="{StaticResource Space1}" CornerRadius="{StaticResource Radius}"
                Background="{StaticResource Renk1x10}" VerticalAlignment="Center" ClipToBounds="True">
          <Border Name="Dolgu" HorizontalAlignment="Stretch" CornerRadius="{StaticResource Radius}"
                  RenderTransformOrigin="0%,50%">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Offset="0" Color="{StaticResource Renk1Color}"/>
                <GradientStop Offset="0.5" Color="{StaticResource Renk3Color}"/>
                <GradientStop Offset="1" Color="{StaticResource Renk2Color}"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Border>
        <TextBlock Name="YuzdeYazisi" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                   FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSize1}"
                   Foreground="{StaticResource TextBody}"/>
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="{StaticResource Space2}" HorizontalAlignment="Right" ClipToBounds="False">
        <Button Name="IndirDugmesi" Theme="{StaticResource KurIkincil}" AutomationProperties.Name="{Binding $self.Content}"/>
        <Button Name="IptalDugmesi" Theme="{StaticResource KurIkincil}" AutomationProperties.Name="{Binding $self.Content}"/>
        <Button Name="IndirVeYukleDugmesi" Theme="{StaticResource KurBirincil}" AutomationProperties.Name="{Binding $self.Content}"/>
        <Button Name="YukleDugmesi" Theme="{StaticResource KurBirincil}" AutomationProperties.Name="{Binding $self.Content}"/>
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
