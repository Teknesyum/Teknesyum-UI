<!-- teknesyum-ui template temalar/avalonia/TemaSecici.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="{{AD}}.Kabuk.TemaSecici"
             ClipToBounds="False">

  <UserControl.Resources>
    <ControlTheme x:Key="TemaKarti" TargetType="Button">
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
      <Setter Property="MinHeight" Value="{StaticResource InputHeight}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize1}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightBody}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TInstant}" Easing="{StaticResource EOut}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^.secili">
        <Setter Property="BorderBrush" Value="{StaticResource Renk1}"/>
        <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      </Style>
      <Style Selector="^.secili /template/ Border#bd">
        <Setter Property="BoxShadow" Value="{DynamicResource TemaHalka}"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="BorderBrush" Value="{StaticResource Disabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <WrapPanel Name="Kap" ClipToBounds="False"/>
</UserControl>
