<!-- teknesyum-ui template ustcubuk/avalonia/KabukStilleri.axaml -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>

    <ControlTheme x:Key="WindowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="{StaticResource TitleBarHeightMax}"/>
      <Setter Property="MinHeight" Value="{StaticResource TitleBarHeightMax}"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd" Background="{TemplateBinding Background}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource Renk1x20}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource Renk1x20}"/>
      </Style>
      <Style Selector="^.close:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource DangerText}"/>
      </Style>
      <Style Selector="^.close:pointerover">
        <Setter Property="Foreground" Value="{StaticResource OnDangerText}"/>
      </Style>
      <Style Selector="^.close:pressed">
        <Setter Property="Foreground" Value="{StaticResource OnDangerText}"/>
      </Style>
      <Style Selector="^.close:pressed /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource DangerText}"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="BadgeButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Warning}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Warning50}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize2}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TInstant}" Easing="{StaticResource EOut}"/>
              </Transitions>
            </Border.Transitions>
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="{StaticResource Space2}"/>
              <Border DockPanel.Dock="Right" Width="{StaticResource Space2}"/>
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.senkron">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      </Style>
      <Style Selector="^.senkron:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
      </Style>
      <Style Selector="^.senkron:pressed">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
      </Style>
      <Style Selector="^.esitleniyor">
        <Setter Property="Foreground" Value="{StaticResource TextLabel}"/>
      </Style>
      <Style Selector="^.esitlendi">
        <Setter Property="Foreground" Value="{StaticResource Success}"/>
      </Style>
      <Style Selector="^.cevrimdisi">
        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
      </Style>
      <Style Selector="^.hazir">
        <Setter Property="Foreground" Value="{StaticResource Success}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Style>
      <Style Selector="^:disabled /template/ Border#bd">
        <Setter Property="RenderTransform" Value="none"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="SigChip" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource LabelBrandBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LabelBrandBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize2}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd" Background="{TemplateBinding Background}" RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TInstant}" Easing="{StaticResource EOut}"/>
              </Transitions>
            </Border.Transitions>
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="{StaticResource Space3}"/>
              <Border DockPanel.Dock="Right" Width="{StaticResource Space3}"/>
              <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space1}">
                <Border Height="{StaticResource FocusWidth}"/>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <Border Name="cizgi" Height="{StaticResource FocusWidth}" Background="{TemplateBinding BorderBrush}"
                        RenderTransformOrigin="50%,50%" RenderTransform="scaleX(0)">
                  <Border.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TBase}" Easing="{StaticResource EOut}"/>
                    </Transitions>
                  </Border.Transitions>
                </Border>
              </StackPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.marka">
        <Setter Property="Foreground" Value="{StaticResource LabelBrandBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LabelBrandBrush}"/>
      </Style>
      <Style Selector="^.destek">
        <Setter Property="Foreground" Value="{StaticResource LabelSupportBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LabelSupportBrush}"/>
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Renk2Text}"/>
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Renk2Text}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Renk2}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#cizgi">
        <Setter Property="RenderTransform" Value="scaleX(1)"/>
      </Style>
      <Style Selector="^:focus-visible /template/ Border#cizgi">
        <Setter Property="RenderTransform" Value="scaleX(1)"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#cizgi">
        <Setter Property="RenderTransform" Value="scaleX(1)"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Disabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Style>
      <Style Selector="^:disabled /template/ Border#cizgi">
        <Setter Property="RenderTransform" Value="scaleX(0)"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Renk3Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize2}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
      <Setter Property="MinHeight" Value="{StaticResource ButtonHeight}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="50%,50%">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource TInstant}" Easing="{StaticResource EOut}"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{StaticResource Renk3x20}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk3x20}"/>
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{StaticResource Renk3x10}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk3x10}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{StaticResource Renk3x20}"/>
        <Setter Property="Foreground" Value="{StaticResource OnRenk3x20}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#bd">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
        <Setter Property="Cursor" Value="No"/>
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <Style Selector="Button">
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="ClipToBounds" Value="False"/>
  </Style>

</Styles>
