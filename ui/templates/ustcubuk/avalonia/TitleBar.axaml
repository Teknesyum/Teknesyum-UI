<!-- teknesyum-ui template ustcubuk/avalonia/TitleBar.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="{{AD}}.Kabuk.TitleBar"
             ClipToBounds="False">

  <UserControl.Styles>
    <Style Selector="Border#DilAnahtari">
      <Setter Property="Background" Value="{StaticResource Renk1x10}"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
    </Style>
    <Style Selector="Border#DilAnahtari Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextLabel}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSize1}"/>
      <Setter Property="FontWeight" Value="{StaticResource WeightSemi}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border#DilAnahtari Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Renk2Text}"/>
    </Style>
    <Style Selector="Border#DilAnahtari Button.secili">
      <Setter Property="Background" Value="{StaticResource Renk1}"/>
      <Setter Property="Foreground" Value="{StaticResource OnRenk1}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Border#DilAnahtari Button.secili:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Renk1}"/>
      <Setter Property="Foreground" Value="{StaticResource OnRenk1}"/>
    </Style>
  </UserControl.Styles>

  <Grid Name="Kap" Height="{StaticResource TitleBarHeightMax}" Background="Transparent" ClipToBounds="False"
        ColumnDefinitions="Auto,*,Auto,Auto,Auto">

    <Border Grid.Column="0" Padding="{StaticResource InputPadding}">
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" VerticalAlignment="Center">
        <Image Name="LogoResmi" Width="{StaticResource IconSize3}" Height="{StaticResource IconSize3}" VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="False"/>
        <TextBlock Name="AdYazisi" Theme="{StaticResource H3}" VerticalAlignment="Center" IsHitTestVisible="False"><Run Foreground="{StaticResource LabelTitleBrush}"/><Run Foreground="{StaticResource LabelTitleAccentBrush}"/></TextBlock>
        <ContentControl Name="SurumAlani" VerticalAlignment="Center" IsVisible="False"/>
      </StackPanel>
    </Border>

    <ContentControl Name="OrtaAlani" Grid.Column="1" VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch" Margin="{StaticResource InputPadding}"/>

    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space1}"
                VerticalAlignment="Center" ClipToBounds="False">
      <Button Name="Senkron" Theme="{StaticResource BadgeButton}" Classes="senkron" IsVisible="False" AutomationProperties.Name="{Binding #SenkronYazisi.Text}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Ellipse Width="{StaticResource Space2}" Height="{StaticResource Space2}" VerticalAlignment="Center"
                   Fill="{Binding $parent[Button].Foreground}"/>
          <TextBlock Name="SenkronYazisi" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Name="Rozet" Theme="{StaticResource BadgeButton}" IsVisible="False" AutomationProperties.Name="{Binding #RozetYazisi.Text}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Ellipse Width="{StaticResource Space2}" Height="{StaticResource Space2}" VerticalAlignment="Center"
                   Fill="{Binding $parent[Button].Foreground}"/>
          <TextBlock Name="RozetYazisi" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <ContentControl Name="EkAlani" VerticalAlignment="Center"/>
      <Border Name="DilAnahtari" VerticalAlignment="Center" IsVisible="False">
        <StackPanel Orientation="Horizontal">
          <Button Name="DilTr" Content="TR" AutomationProperties.Name="Türkçe"/>
          <Button Name="DilEn" Content="EN" AutomationProperties.Name="English"/>
        </StackPanel>
      </Border>
      <Button Name="DestekDugmesi" Theme="{StaticResource SigChip}" Classes="sigchip destek" AutomationProperties.Name="{Binding $self.Content}"/>
      <Button Name="ImzaDugmesi" Theme="{StaticResource SigChip}" Classes="sigchip marka" AutomationProperties.Name="{Binding $self.Content}"/>
    </StackPanel>

    <Border Grid.Column="3" Width="{StaticResource Space3}" IsHitTestVisible="False"/>

    <StackPanel Grid.Column="4" Orientation="Horizontal" ClipToBounds="False">
      <Button Name="KucultDugmesi" Theme="{StaticResource WindowButton}" AutomationProperties.Name="{Binding $self.(ToolTip.Tip)}">
        <Path Data="M0 7H14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
              Width="{StaticResource IconSize1}" Height="{StaticResource IconSize1}" VerticalAlignment="Center"/>
      </Button>
      <Button Name="BuyutDugmesi" Theme="{StaticResource WindowButton}" AutomationProperties.Name="{Binding $self.(ToolTip.Tip)}">
        <Path Name="BuyutSimgesi" Data="M0.5 0.5H13.5V13.5H0.5Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
              Width="{StaticResource IconSize1}" Height="{StaticResource IconSize1}"/>
      </Button>
      <Button Name="KapatDugmesi" Theme="{StaticResource WindowButton}" Classes="close" AutomationProperties.Name="{Binding $self.(ToolTip.Tip)}">
        <Path Data="M0 0L14 14M14 0L0 14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
              Width="{StaticResource IconSize1}" Height="{StaticResource IconSize1}"/>
      </Button>
    </StackPanel>

  </Grid>
</UserControl>
